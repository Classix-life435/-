# ── 台本・構成生成（Claude） ─────────────────────────────
# 未設定でもローカル生成にフォールバックして動作します。
ANTHROPIC_API_KEY=
# 使用モデル（省略時は claude-opus-4-8）
ANTHROPIC_MODEL=claude-opus-4-8

# ── スライド生成（Canva Connect / Autofill） ─────────────
CANVA_CONNECT_TOKEN=
CANVA_BRAND_TEMPLATE_ID=

# ── 解説音声（OpenAI TTS ほか） ─────────────────────────
OPENAI_API_KEY=
# 省略時は gpt-4o-mini-tts / voice=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ── 動画合成ワーカー（Remotion / ffmpeg 等） ────────────
# レンダーワーカーのエンドポイント。未設定なら合成をスキップ。
RENDER_WORKER_URL=

# ── Vimeo アップロード（限定公開） ──────────────────────
VIMEO_ACCESS_TOKEN=
# 埋め込みを許可するドメイン（有料講座の動画流出対策）
VIMEO_ALLOWED_DOMAIN=

# ── LMS（Supabase） ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
